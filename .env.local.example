# =====================================================================
# KebabScore · Variables de entorno (plantilla)
# ---------------------------------------------------------------------
# 1. Copia este archivo como .env.local (ese archivo NO se sube a git).
# 2. En supabase.com → tu proyecto → Project Settings → API:
#    copia la Project URL y la anon / publishable key.
# 3. En Supabase → Authentication → Providers → activa Google y Apple
#    (o pon abajo tus propios CLIENT_ID de Google Cloud / Apple Developer).
# 4. ⚠️ NUNCA pongas aquí la service_role / secret key: cualquier variable
#    que empiece por NEXT_PUBLIC_ viaja al navegador y la puede ver todo el mundo.
#
# Si dejas estos valores vacíos, la app usa su Pasarela OAuth Interactiva
# (/auth/oauth/google y /auth/oauth/apple) para que puedas iniciar sesión
# y probar todo el flujo OAuth 2.0 en local sin bloqueos.
# =====================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: OAuth 2.0 directo con Google Cloud Console / Apple Developer
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# PIN de acceso rápido al Panel de Creador (/creador) en modo local/demo
# (En producción con Supabase, además se valida `profiles.is_creator = true` mediante RLS)
NEXT_PUBLIC_CREATOR_PIN=3000
